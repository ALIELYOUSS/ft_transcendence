generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Interest {
  id    String @id @default(uuid()) @db.Uuid
  name  String @unique
  users User[] @relation("UserInterests")
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  username              String                 @unique
  email                 String                 @unique
  bio                   String?
  avatarUrl             String?                @map("avatar_url")
  latitude              Float?
  longitude             Float?
  role                  UserRole               @default(USER)
  password              String?
  interests             Interest[]             @relation("UserInterests")
  profile               Profile?
  friends               Friend[]               @relation("UserFriends")
  friendOf              Friend[]               @relation("FriendUsers")
  posts                 Post[]
  comments              Comment[]
  likes                 Like[]
  hiddenPosts           HiddenPost[]
  reportedPosts         PostReport[]
  savedPosts            SavedPost[]
  messages              Message[]
  hostedSlots           Slot[]                 @relation("SlotHost")
  slotParticipants      SlotParticipant[]
  groupChatParticipants GroupChatParticipant[]
  refreshedToken        String?                @map("refreshed_token")
  googleId              String?                @unique @map("google_id")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model Profile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Friend {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  friendId  String       @db.Uuid
  status    FriendStatus
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation("UserFriends", fields: [userId], references: [id])
  friend    User         @relation("FriendUsers", fields: [friendId], references: [id])

  @@unique([userId, friendId])
}

model Post {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  content   String?
  imageUrl  String?      @map("image_url")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id])
  comments  Comment[]
  likes     Like[]
  hiddenBy  HiddenPost[]
  reports   PostReport[]
  savedBy   SavedPost[]
}

model HiddenPost {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model PostReport {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  postId    String       @db.Uuid
  reason    String
  status    ReportStatus @default(PENDING)
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model SavedPost {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
}

model Like {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  postId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model Slot {
  id             String            @id @default(uuid()) @db.Uuid
  hostId         String            @map("host_id") @db.Uuid
  title          String
  location       String
  capacityTarget Int               @map("capacity_target")
  status         SlotStatus        @default(OPEN)
  expiresAt      DateTime          @map("expires_at")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  host           User              @relation("SlotHost", fields: [hostId], references: [id])
  participants   SlotParticipant[]
  groupChat      GroupChat?
}

model SlotParticipant {
  id       String   @id @default(uuid()) @db.Uuid
  slotId   String   @map("slot_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at")
  slot     Slot     @relation(fields: [slotId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([slotId, userId])
}

model GroupChat {
  id           String                 @id @default(uuid()) @db.Uuid
  slotId       String                 @unique @map("slot_id") @db.Uuid
  isActive     Boolean                @default(true) @map("is_active")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  slot         Slot                   @relation(fields: [slotId], references: [id])
  messages     Message[]
  participants GroupChatParticipant[]
}

model Message {
  id        String    @id @default(uuid()) @db.Uuid
  chatId    String    @map("chat_id") @db.Uuid
  senderId  String    @map("sender_id") @db.Uuid
  content   String
  createdAt DateTime  @default(now()) @map("created_at")
  chat      GroupChat @relation(fields: [chatId], references: [id])
  sender    User      @relation(fields: [senderId], references: [id])
}

model GroupChatParticipant {
  id        String    @id @default(uuid()) @db.Uuid
  chatId    String    @map("chat_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  createdAt DateTime  @default(now())
  chat      GroupChat @relation(fields: [chatId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([chatId, userId])
}

enum UserRole {
  USER
  ADMIN
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum SlotStatus {
  OPEN
  FULL
  CLOSED
}
