generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Interest {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[] @relation("UserInterests")
}

model User {
  id         Int        @id @default(autoincrement())
  username   String     @unique
  email      String     @unique
  bio        String?
  avatar_url String?
  password   String
  interests  Interest[] @relation("UserInterests")
}
