* 60 * 1000, // 7 days\n    });\n\n    const frontendUrl = process.env.FRONTEND_URL || 'http://localhost';\n    const callbackUrl = new URL(`${frontendUrl}/auth/google/callback`);\n    callbackUrl.searchParams.set('accessToken', tokens.accessToken);\n    callbackUrl.searchParams.set('refreshToken', tokens.refreshToken);\n\n    return response.redirect(callbackUrl.toString());\n  }\n\n  @Post('login')\n  login(@Body() credentials: { email: string; password: string }) {\n    return this.authService.login(credentials.email, credentials.password);\n  }\n\n  @Post('register')\n  create(@Body() createAuthDto: CreateAuthDto) {\n    return this.authService.create(createAuthDto);\n  }\n\n  @Get('list')\n  @UseGuards(JwtGuard, AdminGuard)\n  findAll() {\n    return this.authService.findAll();\n  }\n\n  @Get(':id')\n  @UseGuards(JwtGuard, OwnerOrAdminGuard)\n  findOne(@Param('id') id: string) {\n    return this.authService.findOne(id);\n  }\n\n  @Patch(':id')\n  @UseGuards(JwtGuard, OwnerOrAdminGuard)\n  update(@Param('id') id: string, @Body() updateAuthDto: UpdateAuthDto) {\n    return this.authService.update(id, updateAuthDto);\n  }\n\n  @Delete(':id')\n  @UseGuards(JwtGuard, OwnerOrAdminGuard)\n  remove(@Param('id') id: string) {\n    return this.authService.remove(id);\n  }\n}\n\n    \n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n                   \n    \n         results matching \"\"\n        \n    \n    \n        No results matching \"\"\n    \n\n"},"modules/AuthModule.html":{"url":"modules/AuthModule.html","title":"module - AuthModule","body":"\n                   \n\n\n\n\n\n\n\n\n    Modules\n    AuthModule\n\n\n\n    \n    src/auth/auth.module.ts\n\n\n\n    \n        \n\n\n\n\n\ndependencies\n\nLegend\n\n  Declarations\n\n  Module\n\n  Bootstrap\n\n  Providers\n\n  Exports\n\ncluster_AuthModule\n\n\n\ncluster_AuthModule_imports\n\n\n\ncluster_AuthModule_providers\n\n\n\n\nPrismaModule\n\nPrismaModule\n\n\n\nAuthModule\n\nAuthModule\n\nAuthModule -->\n\nPrismaModule->AuthModul