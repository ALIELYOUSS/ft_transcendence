    this.handlebarsInstance.registerHelper(&#x27;orLength&#x27;, (...args: any[]) &#x3D;&gt; {
      const options &#x3D; args[args.length - 1];
      const values &#x3D; args.slice(0, -1);

      for (const value of values) {
        if (value &amp;&amp; value.length &amp;&amp; value.length &gt; 0) {
          return options.fn(this);
