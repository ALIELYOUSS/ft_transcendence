        { open: &#x27;{{&#x27;, close: &#x27;}}&#x27; },
        { open: &#x27;{{{&#x27;, close: &#x27;}}}&#x27; },
        { open: &#x27;&quot;&#x27;, close: &#x27;&quot;&#x27; },
        { open: &quot;&#x27;&quot;, close: &quot;&#x27;&quot; }
