      autoClosingBrackets: &#x27;always&#x27;,
      autoClosingQuotes: &#x27;always&#x27;,
      suggestOnTriggerCharacters: true,
      acceptSuggestionOnEnter: &#x27;on&#x27;,
      tabCompletion: &#x27;on&#x27;,
