       return;\n        }\n\n        var tableBody = table.querySelector('tbody');\n        if (!tableBody) {\n            return;\n        }\n\n        var rows = Array.prototype.slice.call(tableBody.querySelectorAll('tr'));\n        var summaryContainer = document.querySelector('[data-coverage-summary]');\n        var filterInput = document.querySelector('[data-coverage-filter]');\n        var filterClearButton = document.querySelector('[data-coverage-filter-clear]');\n\n        function toPercent(value, total) {\n            if (!total) {\n                return 0;\n            }\n            return Math.round((value / total) * 100);\n        }\n\n        function getRowCoverageBucket(row) {\n            var className = (row.className || '').toLowerCase();\n            if (className.indexOf('low') !== -1) {\n                return 'undocumented';\n            }\n            if (className.indexOf('medium') !== -1) {\n                return 'partial';\n            }\n            if (className.indexOf('very-good') !== -1 || className.indexOf('good') !== -1) {\n                return 'documented';\n            }\n            return 'partial';\n        }\n\n        function getCoverageStats() {\n            var documented = 0;\n            var partial = 0;\n            var undocumented = 0;\n\n            rows.forEach(function (row) {\n                var bucket = getRowCoverageBucket(row);\n                if (bucket === 'documented') {\n                    documented += 1;\n                } else if (bucket === 'partial') {\n                    partial += 1;\n                } else {\n                    undocumented += 1;\n                }\n            });\n\n            var total = rows.length;\n            var totalCoveragePercent = rows.reduce(function (sum, row) {\n                var scoreCell = row.querySelector('td[data-sort]');\n                var rowScore = scoreCell ? parseFloat(scoreCell.getAttribute('data-sort') || '0') : 0;\n                return sum + (isNaN(rowScore) ? 0 : rowScore);\n            }, 0);\n            var score = total ? Math.floor(totalCoveragePercent / total) : 0;\n\n            return {\n                total: total,\n                documented: documented,\n                partial: partial,\n                undocumented: undocumented,\n                score: score\n            };\n        }\n\n        function buildDonutSegment(title, color, count, total, offset, circumference) {\n            var percent = toPercent(count, total);\n            if (!count) {\n                return '';\n            }\n\n            var arcLength = (count / total) * circumference;\n            var remaining = circumference - arcLength;\n\n            return '' +\n                '' + title + ': ' + count + ' (' + percent + '%)' +\n                '';\n        }\n\n        function renderSummary(stats) {\n            if (!summaryContainer) {\n                return;\n            }\n\n            var total = stats.total;\n            var documentedPercent = toPercent(stats.documented, total);\n            var partialPercent = toPercent(stats.partial, total);\n            var undocumentedPercent = toPercent(stats.undocumented, total);\n            var circumference = 2 * Math.PI * 50;\n            var offset = 0;\n\n            var documentedSegment = buildDonutSegment('Documented', '#4dc71f', stats.documented, total, offset, circumference);\n            offset += total ? (stats.documented / total) * circumference : 0;\n\n            var partialSegment = buildDonutSegment('Partial', '#dab226', stats.partial, total, offset, circumference);\n            offset += total ? (stats.partial / total) * circumference : 0;\n\n            var undocumentedSegment = buildDonutSegment('Undocumented', '#d8624c', stats.undocumented, total, offset, circumference);\n\n            summaryContainer.innerHTML =\n                '' +\n                    'Documentation coverage: ' + stats.score + '%' +\n                    '' + stats.documented + ' documented, ' + stats.partial + ' partial, ' + stats.undocumented + ' undocumented of ' + stats.total + ' entities' +\n                    '' +\n                    documentedSegment +\n                    partialSegment +\n                    undocumentedSegment +\n                    '' + stats.score + '%' +\n                '' +\n                '' +\n                    '' +\n                        '' + stats.total + '' +\n                        'Total' +\n                        '' + stats.total + ' entities' +\n                    '' +\n                    '' +\n                        '' + stats.documented + '' +\n                        'Documented' +\n                        '' + documentedPercent + '%' +\n                    '' +\n                    '' +\n                        '' + stats.partial + '' +\n                        'Partial' +\n                        '' + partialPercent + '%' +\n                    '' +\n                    '' +\n                        '' + stats.undocumented + '' +\n                        'Undocumented' +\n                        '' + undocumentedPercent + '%' +\n                    '' +\n                '';\n        }\n\n        function applyFilter() {\n            if (!filterInput) {\n                return;\n            }\n\n            var query = filterInput.value.toLowerCase().trim();\n            rows.forEach(function (row) {\n                var text = (row.textContent || '').toLowerCase();\n                row.style.display = query.length === 0 || text.indexOf(query) !== -1 ? '' : 'none';\n            });\n\n            if (filterClearButton) {\n                filterClearButton.classList.toggle('is-visible', query.length > 0);\n            }\n        }\n\n        if (filterInput) {\n            filterInput.addEventListener('input', applyFilter);\n            filterInput.addEventListener('keydown', function (event) {\n                if (event.key === 'Escape') {\n                    filterInput.value = '';\n                    applyFilter();\n                }\n            });\n        }\n\n        if (filterClearButton) {\n            filterClearButton.addEventListener('click', function () {\n                if (filterInput) {\n                    filterInput.value = '';\n                    applyFilter();\n                    filterInput.focus();\n                }\n            });\n        }\n\n        renderSummary(getCoverageStats());\n        applyFilter();\n    })();\n\n\n\n                   \n    \n         results matching \"\"\n        \n    \n    \n        No results matching \"\"\n    \n\n"},"dependencies.html":{"url":"dependencies.html","title":"package-dependencies - dependencies","body":"\n                   \n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n    \n        Dependencies\n    \n    \n        \n            \n                \n                    Name\n                    Version\n                \n            \n            \n                \n                    @nestjs/common\n                    ^12.0.1\n                \n                \n                    @nestjs/config\n                    ^12.0.1\n                \n                \n                    @nestjs/core\n                    ^12.0.1\n                \n                \n                    @nestjs/passport\n                    ^12.0.0\n                \n                \n                    @nestjs/platform-express\n                    ^12.0.1\n                \n                \n                    @nestjs/swagger\n                    ^12.0.2\n                \n                \n                    @prisma/adapter-pg\n                    ^7.10.0\n                \n                \n                    @prisma/client\n                    ^7.10.0\n                \n                \n                    bcrypt\n                    ^6.0.0\n                \n                \n                    class-transformer\n                    ^0.5.1\n                \n           