      fontSize: 14,
      wordWrap: &#x27;on&#x27;,
      lineNumbers: &#x27;on&#x27;,
      roundedSelection: false,
      scrollbar: {
        horizontal: &#x27;visible&#x27;,
        vertical: &#x27;visible&#x27;
      },
      overviewRulerLanes: 2,
      quickSuggestions: {
        other: true,
        comments: true,
        strings: true
      },
      parameterHints: {
