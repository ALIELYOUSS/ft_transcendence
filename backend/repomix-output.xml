        })
        .on('click', function (d) {
            var href = resolveNodeHref(d);
            if (href) {
                window.location.href = href;
            }
        });

    //Node icon
    infos_group
        .append('text')
        .attr('font-family', 'Ionicons')
        .attr('y', 5)
        .attr('x', 0)
        .attr('class', function (d) {
            return d.children || d._children ? 'icon has-children' : 'icon';
        })
        .attr('font-size', function (d) {
            return '15px';
