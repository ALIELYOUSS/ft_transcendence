  private registerHandlebarsLanguage() {
    // Register Handlebars language for Monaco Editor
    if (monaco.languages.getLanguages().find((lang: any) &#x3D;&gt; lang.id &#x3D;&#x3D;&#x3D; &#x27;handlebars&#x27;)) {
